# Jupiter API key for tx_size_jupiter tests
# Get one at https://portal.jup.ag
JUPITER_API_KEY=

# Solana mainnet RPC URL for fetching Address Lookup Tables
SOLANA_RPC_URL=

# Comma-separated list of Jupiter measurement scenarios to run.
# Valid values: no_alt, no_alt_peripherals, with_alt, with_alt_peripherals
# Leave empty to run all scenarios.
JUPITER_SCENARIOS=
