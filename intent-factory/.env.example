# Jupiter API key for tx_size_jupiter tests
# Get one at https://portal.jup.ag
JUPITER_API_KEY=

# Solana mainnet RPC URL (also used for QuickNode getTipFloor)
SOLANA_RPC_URL=

# Comma-separated list of Jupiter measurement scenarios to run.
# Valid values: no_alt, no_alt_peripherals, with_alt, with_alt_peripherals
# Leave empty to run all scenarios.
JUPITER_SCENARIOS=

# ---------- E2E Intent Flow ----------

# Payer keypair — path to JSON file or inline JSON array
PAYER_KEYPAIR=

# On-chain program ID for the intent factory
INTENT_FACTORY_PROGRAM_ID=

# Recipient address for intent outcomes
INTENT_RECIPIENT=

# Token mints (defaults: USDC / USDT)
# SOURCE_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
# DESTINATION_MINT=6p6xgHyF7AeE6TZkSmFsko444wqoP15icUSqi2jfGiPN

# Amount of source token to deposit (in base units)
# INTENT_AMOUNT_IN=1000000

# Minimum output override (omit to use Jupiter quote outAmount)
# INTENT_MIN_OUT=

# Execution mode: "normal" or "jito"
# EXECUTION_MODE=normal

# Jito tip percentile from QuickNode getTipFloor (25, 50, 75, 95, 99)
# JITO_TIP_PERCENTILE=75

# Static fallback tip if getTipFloor fails (lamports)
# JITO_TIP_LAMPORTS=10000
