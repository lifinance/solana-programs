{
  "name": "@lifi/solana-programs",
  "version": "0.1.12",
  "description": "",
  "type": "module",
  "keywords": [],
  "author": "Lars Froelich",
  "exports": {
    ".": {
      "types": "./dist/_types/index.d.ts",
      "import": "./dist/_esm/index.js",
      "default": "./dist/_cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/_cjs/index.js",
  "module": "./dist/_esm/index.js",
  "types": "./dist/_types/index.d.ts",
  "typings": "./dist/_types/index.d.ts",
  "scripts": {
    "build": "pnpm clean && pnpm build:cjs && pnpm build:esm && pnpm build:types && oxlint --fix && oxfmt",
    "build:cjs": "tsc --project ./tsconfig.build.json --module commonjs --outDir ./dist/_cjs --removeComments --verbatimModuleSyntax false && printf '{\"type\":\"commonjs\"}' > ./dist/_cjs/package.json  && oxlint --fix && oxfmt",
    "build:esm": "tsc --project ./tsconfig.build.json --module es2020 --outDir ./dist/_esm && printf '{\"type\": \"module\",\"sideEffects\":false}' > ./dist/_esm/package.json && oxlint --fix && oxfmt",
    "build:types": "tsc --project ./tsconfig.build.json --module esnext --declarationDir ./dist/_types --emitDeclarationOnly --declaration --declarationMap && oxlint --fix && oxfmt",
    "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "test": "vitest",
    "test:affected": "vitest run --since-last-run",
    "lint:fix": "oxlint --fix",
    "release": "standard-version -a",
    "release:alpha": "standard-version -a --prerelease alpha --skip.changelog",
    "release:beta": "standard-version -a --prerelease beta --skip.changelog",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.0",
    "borsher": "^3.5.0",
    "bs58": "^6.0.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "standard-version": "^9.5.0",
    "typescript": "5.5.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "^11.1.1"
    }
  },
  "files": [
    "dist/**",
    "lifi-solana-program-1/ts/**"
  ],
  "packageManager": "pnpm@9.14.2"
}
